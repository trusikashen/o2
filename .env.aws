# .env.aws - Переменные для AWS Backend API
# Копируй это в /home/ubuntu/o2/.env на AWS машине
# ВАЖНО: Замени значения на свои реальные значения!

BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=33335
BRIGHTDATA_USERNAME=brd-customer-xxxxxxxx-zone-mobile_proxy1
BRIGHTDATA_PASSWORD=YOUR_BRIGHTDATA_PASSWORD
BRIGHTDATA_ZONE=mobile_proxy1

# AWS Configuration (Required for DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_REAL_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_REAL_AWS_SECRET_ACCESS_KEY
DYNAMODB_ADSTERRA_RUNS_TABLE=AdsterraRuns
DYNAMODB_ADSTERRA_JOBS_TABLE=AdsterraJobs

# SSH Terminal Configuration (для SSH подключения К этой машине)
SSH_VM_IP=100.48.93.18
SSH_USERNAME=ubuntu
SSH_KEY_PATH=./a.pem

# Backend Configuration
NODE_ENV=production
PORT=3000

# Worker Configuration
PROCESS_IMMEDIATELY=false
MAX_WORKER_THREADS=2

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Queue Configuration
QUEUE_POLL_INTERVAL=1000
MAX_RETRIES=3

# Navigation & Timing
NAV_RETRIES=5
NAV_BACKOFF_MS=500
MIN_AD_WAIT=30000
MAX_AD_WAIT=60000

# Timing Configuration
MIN_SCROLL_WAIT=500
MAX_SCROLL_WAIT=1500
MIN_AD_WAIT=10000
MAX_AD_WAIT=30000

# Bot Configuration
TOTAL_BOTS=16000
SESSIONS_PER_BOT=10
TARGET_IMPRESSIONS=160000
