# .env.netlify - Переменные для Netlify фронтенда
# Эти переменные нужно добавить в Netlify UI (Site settings > Build & deploy > Environment)

# API URL (укажи IP/домен своего AWS Backend)
NEXT_PUBLIC_API_URL=https://your-aws-backend.example.com
REACT_APP_API_URL=https://your-aws-backend.example.com

# Публичные переменные (доступны в браузере)
NEXT_PUBLIC_APP_NAME=Adsterra Bot System
NEXT_PUBLIC_ENVIRONMENT=production
